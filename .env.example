# Environment Variables Template

# -----------------------------------------------------------------------------
# SERVER ENVIRONMENT VARIABLES (Render Deployment)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase Postgres Connection String
# Get this from Supabase Project Settings -> Database -> Connection string (Transaction or Session mode)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS Allowed Origin (Client URL)
FRONTEND_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# -----------------------------------------------------------------------------
# CLIENT ENVIRONMENT VARIABLES (Vite / Vercel Deployment)
# -----------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
